<?xml version="1.0" encoding="utf-8"?>
<!--
  Datos de copia/extraccion: ninguno. Refuerza android:allowBackup="false"
  en Android 12+ (nube, transferencia entre dispositivos y adb backup).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
