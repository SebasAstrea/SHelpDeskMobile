<?xml version="1.0" encoding="utf-8"?>
<!-- Port de login.html (panel de cristal + badges + MFA + recordarme). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_sky">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Switch de modo diurno/nocturno (theme-toggle.js) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/themeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Modo Nocturno"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <!-- Badges flotantes (badges.js): toque para ver la descripción -->
            <LinearLayout
                android:id="@+id/badgesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/badgeSistema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:shadowColor="#80000000"
                    android:shadowRadius="2"
                    android:text="Sistemas en línea"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badgeIa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_blue"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="IA Local"
                    android:textColor="#11425E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badgeSla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_silver"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="SLA por Prioridad"
                    android:textColor="#11425E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginVertical="8dp"
                android:contentDescription="Logo HelpDesk"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_helpdesk" />

            <!-- Panel de cristal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#E6FFFFFF"
                    android:shadowRadius="12"
                    android:text="HELPDESK"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Manejo de incidentes TI"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="juan.perez@empresa.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_placeholder"
                    android:textSize="15sp" />

                <FrameLayout
                    android:id="@+id/groupPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ingrese su contraseña"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingEnd="96dp"
                        android:paddingStart="20dp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_placeholder"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/togglePassword"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_badge_silver"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Mostrar"
                        android:textColor="#11425E"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:text="Ingresar"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Segundo paso MFA -->
                <LinearLayout
                    android:id="@+id/mfaSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mfaHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Introduce el código de 6 dígitos de tu app de autenticación."
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/mfaCode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="000000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnMfaVerify"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_primary"
                        android:gravity="center"
                        android:text="Verificar código"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/errorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_msg_error"
                    android:padding="12dp"
                    android:textColor="@color/error_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/loadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminateTint="@color/success_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Autenticando..."
                        android:textColor="@color/success_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/remember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recordarme"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/forgot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="¿Ha olvidado la contraseña? Presione aquí"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="6dp"
                    android:text="¿Usuario nuevo? Regístrate aquí"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Acceso rápido con usuarios genéricos (demo / sin backend) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Entrar con usuario genérico"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/demoSolicitante"
                    style="@style/DemoChip"
                    android:text="Solicitante" />

                <TextView
                    android:id="@+id/demoAgente"
                    style="@style/DemoChip"
                    android:text="Agente" />

                <TextView
                    android:id="@+id/demoCoordinador"
                    style="@style/DemoChip"
                    android:text="Coordinador" />

                <TextView
                    android:id="@+id/demoAdmin"
                    style="@style/DemoChip"
                    android:text="Admin" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingBottom="8dp"
                android:text="Sistema HelpDesk V1.0"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
