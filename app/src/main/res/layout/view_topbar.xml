<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera compartida de todos los dashboards (equivalente a .topbar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sky_top"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/topLogo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_helpdesk" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HelpDesk"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/topTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="Modo Nocturno"
        android:textColor="@color/white"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/topSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_btn_primary"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Volver a Admin"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/topLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_btn_primary"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Salir"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
