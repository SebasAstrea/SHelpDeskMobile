<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de ticket del solicitante (.ticket-item). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ticketId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#TK-0001"
            android:textColor="@color/btn_bottom"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ticketSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asunto del ticket"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ticketDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="📅 1 ene 2026 • Hardware"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ticketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="NUEVO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVerSolucion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_primary"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="💡 Ver solución"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
